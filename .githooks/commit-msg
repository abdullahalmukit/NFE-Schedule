#!/bin/sh
# Keep commit messages short and free of trailers or tool attribution.
msg_file="$1"
# ignore comment lines git adds
body=$(grep -v '^#' "$msg_file")

if echo "$body" | grep -Eiq 'co-authored-by|signed-off-by|claude|anthropic|generated with|generated by|chatgpt|copilot|ai-generated|🤖'; then
  echo "commit-msg: remove trailers and tool/assistant mentions from the message" >&2
  exit 1
fi

subject=$(echo "$body" | sed -n '/./{p;q;}')
if [ ${#subject} -gt 72 ]; then
  echo "commit-msg: subject is ${#subject} characters; keep it short (<= 72, aim for 50)" >&2
  exit 1
fi
exit 0
