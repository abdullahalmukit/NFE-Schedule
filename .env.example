# apps/web/.env.local  (Vercel: Project Settings > Environment Variables)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only, never NEXT_PUBLIC_
CRON_SECRET=                          # Vercel cron -> /api/cron/daily
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                    # server / edge function only

# apps/mobile/.env  (EAS: eas env:create)
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_RELEASE_CHANNEL=preview   # preview (pilot APK) | production (Play Store)

# supabase/functions secrets (supabase secrets set ...)
PUSH_DISPATCH_SECRET=
EXPO_ACCESS_TOKEN=
