{
  "$comment": "NFE Schedule design tokens. Source of truth for packages/ui (web + mobile). Colours sampled from design/logo-sheet.png and design/app-screens-reference.pdf.",
  "brand": {
    "ink": "#14321F",
    "leaf": "#2FA35A",
    "leafLight": "#5FD18A",
    "ground": "#F3F6F1"
  },
  "color": {
    "dark": {
      "bg": "#0C131B",
      "surface": "#161E29",
      "surfaceRaised": "#1C2532",
      "border": "#263140",
      "text": "#F1F5F9",
      "textMuted": "#94A3B8",
      "textFaint": "#64748B",
      "accent": "#3DDC97",
      "onAccent": "#0C131B",
      "accentSoft": "#163A2C",
      "warning": "#F4B446",
      "warningSoft": "#3A2E17",
      "info": "#70AFF2",
      "infoSoft": "#1B2B40",
      "danger": "#F2777A",
      "dangerSoft": "#3B1E22",
      "purple": "#B39BF5",
      "purpleSoft": "#2A2440"
    },
    "light": {
      "bg": "#F3F6F1",
      "surface": "#FFFFFF",
      "surfaceRaised": "#ECF1EA",
      "border": "#DDE5DA",
      "text": "#14321F",
      "textMuted": "#4E6356",
      "textFaint": "#7D8F83",
      "accent": "#1E7A43",
      "onAccent": "#FFFFFF",
      "accentSoft": "#DDF2E3",
      "warning": "#94600F",
      "warningSoft": "#FBEFD9",
      "info": "#2A66A8",
      "infoSoft": "#E1ECF8",
      "danger": "#B23A44",
      "dangerSoft": "#F8E1E3",
      "purple": "#6D4FC2",
      "purpleSoft": "#ECE6FA"
    },
    "coursePalette": {
      "$comment": "One colour per course, assigned by hashing the course code; same course = same colour everywhere. Dark value is the card fill, light value is used in light theme.",
      "dark":  ["#2D6F58", "#8B5A1F", "#2A4A6E", "#4B3F7A", "#7A3348", "#1F6470", "#5D6421", "#3D4A5C"],
      "light": ["#D8F0E3", "#F7E6CC", "#DCE8F6", "#E6E1F5", "#F5DDE3", "#D6EEF1", "#ECEFD2", "#E2E7EE"]
    }
  },
  "font": {
    "display": "Space Grotesk",
    "body": "Inter",
    "bangla": "Hind Siliguri",
    "mono": "JetBrains Mono",
    "$comment": "Space Grotesk for titles and large numbers (logo wordmark), Inter for body. When locale is bn, Bangla text falls back to Hind Siliguri."
  },
  "size": {
    "display": 32, "title": 24, "heading": 20, "body": 16, "small": 14, "caption": 12
  },
  "radius": { "chip": 10, "button": 16, "card": 20, "sheet": 28, "pill": 999 },
  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32 },
  "elevation": { "card": "none (dark) / 0 1px 2px rgba(20,50,31,.06) (light)" },
  "motion": { "fast": 120, "normal": 200, "slow": 320 },
  "layout": { "screenPadding": 20, "bottomNavHeight": 72, "minTouch": 44 }
}
